{"payload":{"files":{"BOOST.md":"---\nname: Wide Wikipedia articles\nsites: en.wikipedia.org\nmade: Yab recipe\npreview: https://en.wikipedia.org/wiki/Web_browser\nchecks:\n  - on /*: some of .mw-page-container\n  - on /*: some of body\n---\n\nLet Wikipedia articles use more of the window.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Wide Wikipedia articles\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://en.wikipedia.org/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":".mw-page-container, .vector-header, .mw-body, .mw-content-container { max-width: none !important; }\n"},"format":1,"id":"wikipedia-wide","sites":["en.wikipedia.org"]},"revision":"5391d006338b89b42ed92872dbc6014c5b6f7c3c9c14c2066bcabb7e39e0f692"}