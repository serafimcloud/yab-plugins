{"payload":{"files":{"BOOST.md":"---\nname: Readable Wikipedia\nsites: en.wikipedia.org\nmade: Yab recipe\npreview: https://en.wikipedia.org/wiki/Main_Page\nchecks:\n  - on /*: some of .mw-parser-output\n  - on /*: some of body\n---\n\nMake Wikipedia's article text larger and easier to read.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Readable Wikipedia\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://en.wikipedia.org/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":".mw-parser-output { font-size: 18px !important; line-height: 1.7 !important; }\n"},"format":1,"id":"wikipedia-readable","sites":["en.wikipedia.org"]},"revision":"a867382ccbd0c0469486dc770c8da59e48096a9cd3372c81890e843d2e32edbd"}