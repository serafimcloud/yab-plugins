{"payload":{"files":{"BOOST.md":"---\nname: Quiet GitHub home\nsites: github.com\nmade: Yab recipe\npreview: https://github.com/\nchecks:\n  - on /*: none of .feed-content\n  - on /*: some of body\n---\n\nHide the activity feed on GitHub's dashboard.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Quiet GitHub home\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://github.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"[data-target='feed-container.feed'], .feed-content { display: none !important; }\n"},"format":1,"id":"github-no-dashboard-feed","sites":["github.com"]},"revision":"51c258e7ac00d152815671d4f19f75c32a6403aeb63ed64b22015ee29ad6db08"}