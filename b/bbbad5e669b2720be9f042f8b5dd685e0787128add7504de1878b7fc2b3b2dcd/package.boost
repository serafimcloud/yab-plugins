{"payload":{"files":{"BOOST.md":"---\nname: Hide follow suggestions\nsites: x.com\nmade: Yab recipe\npreview: https://x.com/home\nchecks:\n  - on /*: none of aside[aria-label='Who to follow']\n  - on /*: some of body\n---\n\nHide Who to follow suggestions on X.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide follow suggestions\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://x.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"aside[aria-label='Who to follow'] { display: none !important; }\n"},"format":1,"id":"x-no-follow-suggestions","sites":["x.com"]},"revision":"bbbad5e669b2720be9f042f8b5dd685e0787128add7504de1878b7fc2b3b2dcd"}