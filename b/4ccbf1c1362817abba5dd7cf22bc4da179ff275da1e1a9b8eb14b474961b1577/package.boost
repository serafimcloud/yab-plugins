{"payload":{"files":{"BOOST.md":"---\nname: Hide video comments\nsites: www.youtube.com\nmade: Yab recipe\npreview: https://www.youtube.com/watch?v=jNQXAC9IVRw\nchecks:\n  - on /*: none of ytd-comments\n  - on /*: some of body\n---\n\nHide YouTube comments below videos.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide video comments\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.youtube.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"ytd-comments { display: none !important; }\n"},"format":1,"id":"youtube-no-comments","sites":["www.youtube.com"]},"revision":"4ccbf1c1362817abba5dd7cf22bc4da179ff275da1e1a9b8eb14b474961b1577"}