{"payload":{"files":{"BOOST.md":"---\nname: Readable MDN\nsites: developer.mozilla.org\nmade: Yab recipe\npreview: https://developer.mozilla.org/en-US/docs/Web\nchecks:\n  - on /*: some of main\n  - on /*: some of body\n---\n\nMake MDN article text larger and code easier to read.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Readable MDN\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://developer.mozilla.org/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"main { font-size: 18px !important; line-height: 1.7 !important; }\npre { line-height: 1.65 !important; }\n"},"format":1,"id":"mdn-readable","sites":["developer.mozilla.org"]},"revision":"5d8f1e82f8d87b22ad3e72a2642e5461ff74320c5e5ef15b596fd78d7d4e12ad"}