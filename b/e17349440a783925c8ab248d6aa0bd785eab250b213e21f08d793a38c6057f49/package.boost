{"payload":{"files":{"BOOST.md":"---\nname: Hide hot network questions\nsites: stackoverflow.com\nmade: Yab recipe\npreview: https://stackoverflow.com/questions\nchecks:\n  - on /*: none of #hot-network-questions\n  - on /*: some of body\n---\n\nHide Hot Network Questions on Stack Overflow.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide hot network questions\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://stackoverflow.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"#hot-network-questions { display: none !important; }\n"},"format":1,"id":"stackoverflow-hide-hot","sites":["stackoverflow.com"]},"revision":"e17349440a783925c8ab248d6aa0bd785eab250b213e21f08d793a38c6057f49"}