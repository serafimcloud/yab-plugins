{"payload":{"files":{"BOOST.md":"---\nname: Readable Hacker News\nsites: news.ycombinator.com\nmade: Yab recipe\npreview: https://news.ycombinator.com/\nchecks:\n  - on /*: some of .title\n  - on /*: some of body\n---\n\nMake Hacker News text larger with more breathing room.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Readable Hacker News\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://news.ycombinator.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"body, td, .comment, .title, .comhead, .subtext { font-size: 15px !important; line-height: 1.65 !important; }\n.spacer { height: 12px !important; }\n"},"format":1,"id":"hn-readable","sites":["news.ycombinator.com"]},"revision":"1f627498f6334f7638d7a428dacebb4149a16cc5e8b044c5d6edd393d7229735"}