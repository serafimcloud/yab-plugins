{"payload":{"files":{"BOOST.md":"---\nname: Readable package docs\nsites: www.npmjs.com\nmade: Yab recipe\npreview: https://www.npmjs.com/package/react\nchecks:\n  - on /*: some of #readme\n  - on /*: some of body\n---\n\nMake npm package READMEs easier to read.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Readable package docs\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.npmjs.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"#readme { font-size: 17px !important; line-height: 1.7 !important; max-width: 85ch; }\n"},"format":1,"id":"npm-readable-readme","sites":["www.npmjs.com"]},"revision":"281982ae3a9ed10c700af41608560a638d9baff2a61d59d0565627cb36984c66"}