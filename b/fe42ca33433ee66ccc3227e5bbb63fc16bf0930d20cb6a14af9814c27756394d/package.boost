{"payload":{"files":{"BOOST.md":"---\nname: Hide promoted Reddit cards\nsites: www.reddit.com\nmade: Yab recipe\npreview: https://www.reddit.com/\nchecks:\n  - on /*: none of shreddit-ad-post\n  - on /*: some of body\n---\n\nHide cards marked as promoted on Reddit.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide promoted Reddit cards\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.reddit.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"shreddit-ad-post, [data-promoted='true'] { display: none !important; }\n"},"format":1,"id":"reddit-hide-promoted","sites":["www.reddit.com"]},"revision":"fe42ca33433ee66ccc3227e5bbb63fc16bf0930d20cb6a14af9814c27756394d"}