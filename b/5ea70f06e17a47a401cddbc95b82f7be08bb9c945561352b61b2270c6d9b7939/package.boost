{"payload":{"files":{"BOOST.md":"---\nname: Quiet Reddit sidebar\nsites: www.reddit.com\nmade: Yab recipe\npreview: https://www.reddit.com/\nchecks:\n  - on /*: none of #right-sidebar-container\n  - on /*: some of body\n---\n\nHide Reddit's right sidebar while keeping the feed.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Quiet Reddit sidebar\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.reddit.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"#right-sidebar-container { display: none !important; }\n"},"format":1,"id":"reddit-hide-sidebar","sites":["www.reddit.com"]},"revision":"5ea70f06e17a47a401cddbc95b82f7be08bb9c945561352b61b2270c6d9b7939"}