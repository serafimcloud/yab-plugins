{"payload":{"files":{"BOOST.md":"---\nname: Hide HN scores\nsites: news.ycombinator.com\nmade: Yab recipe\npreview: https://news.ycombinator.com/\nchecks:\n  - on /*: none of .score\n  - on /*: some of body\n---\n\nHide Hacker News scores while keeping stories and comments.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide HN scores\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://news.ycombinator.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":".score { display: none !important; }\n"},"format":1,"id":"hn-hide-scores","sites":["news.ycombinator.com"]},"revision":"37e537808de737645f730595579004cd15da56a50d3e013ec025ccf395dee445"}