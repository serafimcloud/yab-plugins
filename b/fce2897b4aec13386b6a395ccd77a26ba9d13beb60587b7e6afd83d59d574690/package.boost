{"payload":{"files":{"BOOST.md":"---\nname: Hide trends\nsites: x.com\nmade: Yab recipe\npreview: https://x.com/home\nchecks:\n  - on /*: none of [data-testid='trend']\n  - on /*: some of body\n---\n\nHide the What's happening and trending blocks on X.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide trends\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://x.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"[aria-label='Timeline: Trending now'], [data-testid='trend'] { display: none !important; }\n"},"format":1,"id":"x-no-trends","sites":["x.com"]},"revision":"fce2897b4aec13386b6a395ccd77a26ba9d13beb60587b7e6afd83d59d574690"}