{"payload":{"files":{"BOOST.md":"---\nname: Hide related videos\nsites: www.youtube.com\nmade: Yab recipe\npreview: https://www.youtube.com/watch?v=jNQXAC9IVRw\nchecks:\n  - on /*: none of ytd-watch-next-secondary-results-renderer\n  - on /*: some of body\n---\n\nHide related videos beside YouTube's player.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Hide related videos\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://www.youtube.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":"ytd-watch-next-secondary-results-renderer { display: none !important; }\n"},"format":1,"id":"youtube-no-related","sites":["www.youtube.com"]},"revision":"e543d2ddb05aa8ca8328f37df1de9fe05e18f068d38ed54ba949bc71495258b7"}