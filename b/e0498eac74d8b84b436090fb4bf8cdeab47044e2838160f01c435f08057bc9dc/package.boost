{"payload":{"files":{"BOOST.md":"---\nname: Wider repositories\nsites: github.com\nmade: Yab recipe\npreview: https://github.com/swiftlang/swift\nchecks:\n  - on /*: some of .container-xl\n  - on /*: some of body\n---\n\nLet GitHub repository content use the full available width.\n","manifest.json":"{\n  \"manifest_version\": 3,\n  \"name\": \"Wider repositories\",\n  \"version\": \"1.0.0\",\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"https://github.com/*\"\n      ],\n      \"css\": [\n        \"page/style.css\"\n      ],\n      \"run_at\": \"document_end\"\n    }\n  ]\n}\n","page/style.css":".container-xl { max-width: none !important; }\n"},"format":1,"id":"github-wide-repository","sites":["github.com"]},"revision":"e0498eac74d8b84b436090fb4bf8cdeab47044e2838160f01c435f08057bc9dc"}